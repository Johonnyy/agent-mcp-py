# agent-mcp-py configuration — copy to `.env` and fill in.
# All values are read by src/agent_mcp/config.py (pydantic-settings).
# Env vars override .env. Constructor arguments to AgentMCPServer override both.

# --- Identity ---
# Short snake_case service name. Also the namespace agent_runtime prefixes onto
# this server's tools (<app_name>__<tool>), so keep it brief.
AGENT_MCP_APP_NAME=finance
AGENT_MCP_VERSION=0.1.0
# This server's externally reachable base URL, no /mcp suffix. Required to register
# with the sync store — a service can't work out its own public address, and
# publishing an unreachable one is worse than not registering at all.
AGENT_MCP_PUBLIC_URL=https://finance.johnny.dev

# --- Auth (fails closed) ---
# Comma-separated bearer tokens. Prefer the "name:token" form: the name is what
# lands in the usage log, so calls are attributable without ever storing the secret.
# A bare token gets a sha256: fingerprint instead.
AGENT_MCP_KEYS=amber:replace-me,spawner:replace-me-too
# Optional: read keys from a DIFFERENT env var instead (e.g. FINANCE_MCP_KEYS).
#
# TRAP: this is read through os.environ, and pydantic-settings loads .env into the
# settings object WITHOUT exporting it to the environment. So a key placed only in
# this file, under a name given here, will not be found — and because auth fails
# closed, the server then rejects everything for no visible reason. Either export
# it for real, or just use AGENT_MCP_KEYS above.
# AGENT_MCP_AUTH_KEYS_ENV=FINANCE_MCP_KEYS
#
# Local development only. When true, every MCP call is admitted with no token and
# logged as caller "anonymous". Never set this in production.
AGENT_MCP_ALLOW_ANONYMOUS=false

# --- Depth (agent-to-agent loop prevention) ---
# Hops allowed before a call is refused. Callers pre-check this client-side using
# agent_mcp.depth.MAX_AGENT_DEPTH; this is the server-side backstop.
AGENT_MCP_MAX_AGENT_DEPTH=5

# --- Usage log ---
AGENT_MCP_USAGE_ENABLED=true
# SQLite file for the log. Point it at the app's existing DB to co-locate the rows
# (WAL makes that safe), or pass your own UsageSink to share one connection.
AGENT_MCP_USAGE_DB_PATH=agent_mcp.db
# Rows older than this are pruned on the heartbeat, not on the write path.
AGENT_MCP_USAGE_RETENTION_DAYS=30

# --- Sync store (discovery; optional) ---
# Empty disables registration entirely. The app still serves normally — it is just
# not discoverable. Registration never blocks or breaks startup.
AGENT_MCP_SYNC_STORE_URL=
AGENT_MCP_SYNC_STORE_TOKEN=
AGENT_MCP_HEARTBEAT_INTERVAL_S=300
AGENT_MCP_SYNC_TIMEOUT_S=5

# --- Peers (outbound call_peer) ---
# Static name=url map, comma separated. Until the hosted sync store exists this is
# the primary discovery mechanism. It also always beats the store, so a local
# override during an incident is not undone by the next heartbeat.
AGENT_MCP_PEERS=finance=https://finance.johnny.dev,school=https://school.johnny.dev
# Bearer token presented to peers that don't carry their own in the registry.
AGENT_MCP_PEER_TOKEN=
AGENT_MCP_PEER_TIMEOUT_S=30
